<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Motor de pipeline genérico inspirado em middleware do ASP.NET Core, com Result pattern e zero dependências externas.</Description>
    <PackageTags>pipeline;middleware;result-pattern</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Equals/GetHashCode/operadores são autoexplicativos; docs focam na API que o usuário realmente lê. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../assets/icon.png" Pack="true" PackagePath="" />
    <None Include="$(MSBuildThisFileDirectory)../../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
